# Copy this file to .env and fill in real values — .env itself is
# gitignored (never committed); this example file is the only one that is.

# Signs the login session cookie. Required for anything beyond a single
# developer's machine — generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PRAXIS_SESSION_SECRET=

# "dev" (default if unset) = the no-password username dropdown, for local
# testing only. "google" = real login — see README's "Real login (Google)"
# section for how to get the values below.
PRAXIS_AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — narrows Google's account picker to one Workspace domain.
GOOGLE_HOSTED_DOMAIN=unicamp.br
